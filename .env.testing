APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Fast, isolated tests by default
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Optional: Use MySQL for tests (uncomment to enable; requires Docker MySQL running)
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=class_treasurer_test
# DB_USERNAME=laravel
# DB_PASSWORD=secret
